{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C atual (gcc -g)",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila o arquivo C aberto com símbolos de debug."
        }
    ]
}
